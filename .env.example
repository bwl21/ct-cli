# ChurchTools host (no trailing slash, no /api suffix). Defaults to prod.
CT_HOST=https://eqrm.church.tools

# Personal login token (ChurchTools → user settings). Prefer `ct auth login`,
# which stores it in ~/.config/ct-cli/credentials.json (mode 0600). This env
# var is for CI / one-off use and takes precedence over the stored token.
CT_LOGINTOKEN=
