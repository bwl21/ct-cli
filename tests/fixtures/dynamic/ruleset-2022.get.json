    },
    "process": {
      "groupOnly": {
        "active": {
          "handleMembership": {
            "groupMemberStatus": "none",
            "groupTypeRoleId": 29
          }
        }
      },
      "queryResultOnly": {
        "none": {
          "handleMembership": {
            "groupMemberStatus": "active",
            "groupTypeRoleId": 29
          }
        }
      },
      "groupAndQueryResult": {}
    }
  }
]
